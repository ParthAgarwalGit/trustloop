# Copy to `.env` and fill in. Never commit `.env`.
#
# Vite inlines every VITE_* value into the built JavaScript, so treat all of these
# as PUBLIC. The Supabase anon key below is safe to expose ONLY because the schema
# in server/supabase_schema.sql grants it insert-and-nothing-else. Never put a
# service-role key here -- it would let anyone read and delete your whole dataset.

# --- where completed sessions go -------------------------------------------
# none     = no transmission; participants download a JSON file (local piloting)
# supabase = POST to a Supabase REST table
# endpoint = POST to any URL you control
VITE_DATA_SINK=none

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_TABLE=sessions

VITE_POST_ENDPOINT=

# --- participant payment ----------------------------------------------------
# From your Prolific study settings.
VITE_COMPLETION_URL=https://app.prolific.com/submissions/complete?cc=XXXXXXXX
VITE_COMPLETION_CODE=XXXXXXXX

# --- shown on the consent and debrief screens -------------------------------
VITE_RESEARCHER_NAME=Your Name
VITE_RESEARCHER_EMAIL=you@example.edu
VITE_INSTITUTION=Your Institution
VITE_ETHICS_REF=IRB-2026-XXXX
