{
  "name": "trustloop-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Participant-facing experiment app for the TrustLoop study",
  "scripts": {
    "stimuli": "python ../stimuli/build_trials.py && python ../stimuli/validate_trials.py",
    "predev": "npm run stimuli",
    "prebuild": "npm run stimuli",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
